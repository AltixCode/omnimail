# OmniMail environment. Names only — never commit values.
# All Altix integrations are optional: leave a variable empty and that integration is off.

# --- Core (existing) ---
DATABASE_URL=
APP_SECRET_KEY=
NEXT_PUBLIC_APP_URL=

# --- AltixAuth (Authentik OIDC), runtime ---
# Redirect URI to register in Authentik: <APP_URL>/api/auth/oidc/callback
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Public origin used for the redirect URI; falls back to X-Forwarded-Host/Proto.
APP_URL=

# --- AltixAnalytics, runtime (read per request; no rebuild needed) ---
ANALYTICS_WEBSITE_ID=

# --- AltixErrorTrack ---
# Server (instrumentation.ts), runtime
ERRORTRACK_DSN=
# Browser DSN served from the server per request, runtime
ERRORTRACK_DSN_BROWSER=
# Optional alternative browser DSN baked in at BUILD time
NEXT_PUBLIC_ERRORTRACK_DSN=
