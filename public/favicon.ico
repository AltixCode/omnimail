<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
  <defs>
    <linearGradient id="bgGrad" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#2563eb" />
      <stop offset="100%" stop-color="#1d4ed8" />
    </linearGradient>
    <linearGradient id="mailFold" x1="16" y1="20" x2="48" y2="44" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#ffffff" />
      <stop offset="100%" stop-color="#e2e8f0" />
    </linearGradient>
    <filter id="shadow" x="8" y="14" width="48" height="40" filterUnits="userSpaceOnUse" color-interpolation-filters="sRGB">
      <feDropShadow dx="0" dy="3" stdDeviation="2" flood-opacity="0.25" flood-color="#0f172a" />
    </filter>
  </defs>

  <!-- App Rounded Base -->
  <rect width="64" height="64" rx="16" fill="url(#bgGrad)" />

  <!-- Inner Soft Border -->
  <rect x="1" y="1" width="62" height="62" rx="15" stroke="rgba(255,255,255,0.2)" stroke-width="1.5" />

  <!-- Envelope Body -->
  <g filter="url(#shadow)">
    <!-- Base Mail Back -->
    <rect x="14" y="20" width="36" height="26" rx="4" fill="url(#mailFold)" />

    <!-- Mail Flap Crease Lines -->
    <path d="M14 22L32 35L50 22" stroke="#94a3b8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
    <path d="M14 44L26 31" stroke="#cbd5e1" stroke-width="1.8" stroke-linecap="round" />
    <path d="M50 44L38 31" stroke="#cbd5e1" stroke-width="1.8" stroke-linecap="round" />

    <!-- Calendar Sync Mark -->
    <circle cx="43" cy="22" r="6" fill="#10b981" stroke="#ffffff" stroke-width="1.8" />
    <path d="M41 22L42.5 23.5L45.5 20.5" stroke="#ffffff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
  </g>
</svg>
